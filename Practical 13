import threading
import time

def task1():
    print("Task 1: Starting data processing")
    time.sleep(2)
    print("Task 1: Data processing completed")

def task2():
    print("Task 2: Downloading a file")
    time.sleep(3)
    print("Task 2: File downloaded successfully")

def task3():
    print("Task 3: Sending an email")
    time.sleep(1)
    print("Task 3: Email sent successfully")

# Create multiple threads
t1 = threading.Thread(target=task1)
t2 = threading.Thread(target=task2)
t3 = threading.Thread(target=task3)

# Start all threads
t1.start()
t2.start()
t3.start()

# Wait for all threads to finish
t1.join()
t2.join()
t3.join()

print("All tasks completed successfully")
